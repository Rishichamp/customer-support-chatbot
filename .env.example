LLM_PROVIDER=openai
OPENAI_API_KEY=sk-proj-your-key-here
LLM_MODEL=gpt-4o-mini
STRONG_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
CHROMA_PATH=./chroma_db
DOCS_PATH=./sample_docs
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=4
SIMILARITY_THRESHOLD=0.62
MAX_HISTORY_TURNS=8
TEMPERATURE=0.1
